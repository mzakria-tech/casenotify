def _status_pill(status: str) -> str:
    s = status.lower()
    if "in progress" in s:
        cls = "inprogress"
    elif "waiting on red hat" in s:
        cls = "waiting-rh"
    elif "waiting on customer" in s or "customer responded" in s:
        cls = "waiting-cust"
    elif "closed" in s:
        cls = "closed"
    elif "new" in s:
        cls = "new"
    else:
        cls = "default"
    return f'<span class="status-pill {cls}">{status}</span>'


def _render_watchdog(entries: list) -> str:
    if not entries:
        return '<div class="log-line"><span class="info">🛡️ Watchdog active — monitoring all services every 30s</span></div>'
    html = ""
    for e in entries[-10:]:
        cls = "ok" if "✓" in e else ("err" if "✗" in e or "⚠" in e else "info")
        html += f'<div class="log-line"><span class="{cls}">{e}</span></div>'
    return html


def _render(data: dict) -> str:
    def svc(d):
        return ("on", "Running") if d["running"] else ("off", "Stopped")

    ms_cls, ms_text = svc(data["mailserver"])
    pl_cls, pl_text = svc(data["poller"])
    cr_cls, cr_text = svc(data["chrome"])
    ma_cls, ma_text = svc(data["mailapp"])
    vpn_cls, vpn_text = svc(data["vpn"])

    # Start buttons for stopped services
    def start_btn(svc_id, label="▶ Start"):
        return f'<button class="start-btn" onclick="startService(\'{svc_id}\', this)">{label}</button>'

    ms_fix = "" if data["mailserver"]["running"] else start_btn("mailserver", "▶ Start Mail Server")
    pl_fix = "" if data["poller"]["running"] else start_btn("poller", "▶ Start Poller")
    if data["chrome"]["running"]:
        cr_fix = ""
    else:
        # Heal command is embedded in code (update.sh) — shown on the card, not only in chat
        safe_heal = HEAL_CMD.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        cr_fix = (
            start_btn("ssh", "🔧 Fix SSH (auto)")
            + f'<div class="fix-cmd" title="Copy and run in Terminal">{safe_heal}'
            f'<span class="copy-hint">update.sh</span></div>'
        )
    ma_fix = "" if data["mailapp"]["running"] else start_btn("mailapp", "▶ Open Mail.app")
    vpn_fix = "" if data["vpn"]["running"] else '<div class="svc-fix" style="font-size:11px">Connect Red Hat VPN</div>'

    # Cases table — dynamically match Salesforce columns
    cases = data["cases"]
    columns = data.get("columns", [])
    # Filter out empty/action columns
    skip_labels = {"", "action", "show actions"}
    display_cols = [c for c in columns if c.lower() not in skip_labels]

    if cases:
        # Build header
        header_cells = ""
        for col in display_cols:
            header_cells += f"<th>{col}</th>"
        if not display_cols:
            header_cells = "<th>Case #</th><th>Status</th><th>Subject</th>"

        # Build rows
        rows = ""
        for c in cases:
            link = f'https://redhatsupport.lightning.force.com/lightning/r/Case/{c["id"]}/view'
            fields = c.get("fields", {})
            if display_cols:
                cells = ""
                for col in display_cols:
                    val = fields.get(col, "")
                    col_lower = col.lower()
                    if "case" in col_lower and "number" in col_lower or col_lower == "casenumber":
                        cells += f'<td><a class="case-link" href="{link}" target="_blank"><span class="case-num">{val}</span></a></td>'
                    elif col_lower == "status":
                        cells += f"<td>{_status_pill(val)}</td>"
                    elif "subject" in col_lower:
                        cells += f'<td style="color:#e2e8f0">{val[:70]}</td>'
                    elif "owner" in col_lower:
                        cells += f'<td style="color:#60a5fa;font-weight:600">{val}</td>'
                    elif "severity" in col_lower:
                        cells += f'<td style="font-size:12px;color:#94a3b8">{val}</td>'
                    else:
                        cells += f'<td style="font-size:12px;color:#cbd5e1">{val[:50]}</td>'
                rows += f"<tr>{cells}</tr>"
            else:
                rows += (
                    f'<tr>'
                    f'<td><a class="case-link" href="{link}" target="_blank"><span class="case-num">{c["number"]}</span></a></td>'
                    f'<td>{_status_pill(c["status"])}</td>'
                    f'<td style="color:#e2e8f0">{c["subject"][:60]}</td>'
                    f'</tr>'
                )
        cases_html = (
            '<table class="case-table"><thead><tr>'
            + header_cells +
            '</tr></thead><tbody>' + rows + '</tbody></table>'
        )
    else:
        cases_html = '<div class="empty"><div class="empty-icon">📭</div>No cases tracked yet — waiting for first successful poll</div>'

    # Emails
    emails = data["emails"]
    if emails:
        cards = ""
        for e in emails:
            body = (e.get("body") or "")[:200].replace("<", "&lt;")
            cards += (
                f'<div class="email-card">'
                f'<div class="email-top"><span class="email-subj">{e["subject"]}</span>'
                f'<span class="email-date">{e["date"]}</span></div>'
                f'<div class="email-from">To: {e.get("to","")}</div>'
                f'<div class="email-body">{body}</div></div>'
            )
        emails_html = cards
    else:
        emails_html = '<div class="empty"><div class="empty-icon">🔕</div>No notifications yet — emails appear here when a case status changes</div>'

    # Log
    log_lines = data["logs"]
    log_html = ""
    for line in log_lines:
        cls = "ok" if "ok cases=" in line else ("err" if "failed" in line or "error" in line.lower() else "info")
        ts = line[:20] if len(line) > 20 else ""
        msg = line[21:] if len(line) > 21 else line
        log_html += f'<div class="log-line"><span class="ts">{ts}</span> <span class="{cls}">{msg}</span></div>'
    if not log_html:
        log_html = '<div class="log-line">No log entries yet</div>'

    # Last run
    lr = data.get("last_run", "")
    if lr:
        try:
            dt = datetime.fromisoformat(lr)
            ago = (datetime.now(timezone.utc) - dt).total_seconds()
            if ago < 60:
                lr_text = f"{int(ago)}s ago"
            elif ago < 3600:
                lr_text = f"{int(ago/60)}m ago"
            else:
                lr_text = f"{int(ago/3600)}h ago"
        except Exception:
            lr_text = lr[:19]
    else:
        lr_text = "never"

    scrape = data.get("last_scrape", "unknown")
    scrape_map = {"success": "✅ last scrape OK", "failed": "❌ last scrape failed", "unknown": "⏳ pending"}
    scrape_text = scrape_map.get(scrape, scrape)

    html = DASHBOARD
    replacements = {
        "{ms_cls}": ms_cls, "{ms_text}": ms_text, "{ms_fix}": ms_fix,
        "{pl_cls}": pl_cls, "{pl_text}": pl_text, "{pl_fix}": pl_fix,
        "{cr_cls}": cr_cls, "{cr_text}": cr_text, "{cr_fix}": cr_fix,
        "{ma_cls}": ma_cls, "{ma_text}": ma_text, "{ma_fix}": ma_fix,
        "{vpn_cls}": vpn_cls, "{vpn_text}": vpn_text, "{vpn_fix}": vpn_fix,
        "{case_count}": str(data["case_count"]),
        "{email_count}": str(data["email_count"]),
        "{last_run}": lr_text,
        "{scrape_status}": scrape_text,
        "{cases_html}": cases_html,
        "{emails_html}": emails_html,
        "{log_html}": log_html,
        "{watchdog_html}": _render_watchdog(data.get("watchdog_log", [])),
        "{case_list_url}": data.get("case_list_url", ""),
        "{notify_email}": data.get("notify_email", "not configured"),
    }
    for k, v in replacements.items():
        html = html.replace(k, v)
    return html


class WebHandler(BaseHTTPRequestHandler):
    def do_POST(self):
        """Handle fix/start requests from dashboard buttons."""
        if self.path == "/api/start":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length).decode() if length else ""
            try:
                req = json.loads(body)
            except Exception:
                req = {}
            svc = req.get("service", "")
            result = {"ok": False, "msg": "unknown service"}

            if svc == "poller":
                plist = os.path.join(LAUNCH_DIR, f"{POLLER_LABEL}.plist")
                subprocess.run(["launchctl", "unload", plist], capture_output=True, timeout=5)
                time.sleep(1)
                subprocess.run(["launchctl", "load", plist], capture_output=True, timeout=5)
                subprocess.run(["launchctl", "start", POLLER_LABEL], capture_output=True, timeout=5)
                result = {"ok": True, "msg": "Poller restarted"}
                _watchdog_log("✓ Poller restarted (dashboard button)")

            elif svc == "ssh":
                # Test SSH; if failed, open Terminal to auto-run sf-ssh-setup (password once)
                try:
                    cfg = _read_config()
                    ssh_user = cfg.get("supportshell_user", os.environ.get("USER", "mzakria"))
                    ssh_host = f"{ssh_user}@supportshell-1.sush-001.prod.us-west-2.aws.redhat.com"
                    r = subprocess.run(
                        ["ssh", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes",
                         "-o", "PreferredAuthentications=publickey,gssapi-with-mic",
                         "-o", "GSSAPIAuthentication=yes",
                         "-o", "StrictHostKeyChecking=no", ssh_host, "echo ok"],
                        capture_output=True, text=True, timeout=15)
                    if "ok" in (r.stdout or ""):
                        SSH_STATUS["running"] = True
                        result = {"ok": True, "msg": "SSH connected OK"}
                        _watchdog_log("✓ SSH tested OK (dashboard button)")
                    else:
                        setup = os.path.expanduser("~/.local/bin/sf-ssh-setup")
                        if os.path.exists(setup) and sys.platform == "darwin":
                            subprocess.Popen([
                                "osascript", "-e",
                                f'tell application "Terminal" to do script "{setup}"'
                            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            result = {"ok": True, "msg": "Opened Terminal — enter password once if asked"}
                            _watchdog_log("⚠ SSH failed — opened sf-ssh-setup in Terminal")
                        else:
                            result = {"ok": False, "msg": f"SSH failed — run: sf-ssh-setup"}
                            _watchdog_log("✗ SSH test failed (dashboard button)")
                except subprocess.TimeoutExpired:
                    result = {"ok": False, "msg": "SSH timed out — connect Red Hat VPN"}
                except Exception as e:
                    result = {"ok": False, "msg": str(e)[:80]}

            elif svc == "mailapp":
                subprocess.run(["open", "-a", "Mail"], capture_output=True, text=True, timeout=10)
                result = {"ok": True, "msg": "Mail.app opened"}
                _watchdog_log("✓ Mail.app opened (dashboard button)")

            elif svc == "mailserver":
                result = {"ok": True, "msg": "Already running (you're looking at it)"}

            elif svc == "fix_all":
                steps = []
                # Fix poller
                plist = os.path.join(LAUNCH_DIR, f"{POLLER_LABEL}.plist")
                subprocess.run(["launchctl", "unload", plist], capture_output=True, timeout=5)
                time.sleep(1)
                subprocess.run(["launchctl", "load", plist], capture_output=True, timeout=5)
                subprocess.run(["launchctl", "start", POLLER_LABEL], capture_output=True, timeout=5)
                steps.append("Poller restarted")
                # Fix Mail.app
                subprocess.run(["open", "-gja", "Mail"], capture_output=True, timeout=10)
                steps.append("Mail.app started")
                # Clear stuck notifications
                try:
                    import sqlite3
                    db = os.path.expanduser("~/.local/state/casenotify.db")
                    c = sqlite3.connect(db, timeout=5)
                    c.execute("UPDATE notifications SET status='PENDING', retry_count=0 WHERE status='RETRY'")
                    c.commit()
                    c.close()
                    steps.append("Stuck notifications cleared")
                except Exception:
                    pass
                # Trigger immediate poll
                python = subprocess.run(["which", "python3"], capture_output=True, text=True).stdout.strip()
                subprocess.Popen(
                    [python, os.path.expanduser("~/.local/bin/sf-case-poller"), "--once"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                steps.append("Immediate poll triggered")
                result = {"ok": True, "msg": " → ".join(steps)}
                _watchdog_log("✓ Fix All executed (dashboard button)")

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(result).encode())
            return

        if self.path == "/api/config":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length).decode() if length else ""
            try:
                req = json.loads(body)
            except Exception:
                req = {}
            new_url = req.get("case_list_url", "").strip()
            if new_url and "lightning" in new_url:
                cfg = _read_config()
                cfg["case_list_url"] = new_url
                _save_config(cfg)
                # Restart poller with new URL
                plist = os.path.join(LAUNCH_DIR, f"{POLLER_LABEL}.plist")
                subprocess.run(["launchctl", "unload", plist], capture_output=True)
                __import__('time').sleep(1)
                # Clear state so it re-initialises with new view
                state_f = os.path.expanduser("~/.local/state/sf-case-status.json")
                if os.path.exists(state_f):
                    os.remove(state_f)
                subprocess.run(["launchctl", "load", plist], capture_output=True)
                result = {"ok": True, "msg": "Saved & poller restarted"}
            else:
                result = {"ok": False, "msg": "Invalid URL"}
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(result).encode())
            return

        self.send_response(404)
        self.end_headers()

    def do_GET(self):
        if self.path == "/api/status":
            data = _get_status_data()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(data, default=str).encode())
            return

        if self.path == "/api/emails":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(EMAILS).encode())
            return

        data = _get_status_data()
        html = _render(data)
        self.send_response(200)
        self.send_header("Content-Type", "text/html")
        self.end_headers()
        self.wfile.write(html.encode())

    def log_message(self, fmt, *args):
        pass


def run_web(port=8090):
    server = HTTPServer(("0.0.0.0", port), WebHandler)
    print(f"[WEB]  http://localhost:{port}")
    server.serve_forever()


def _watchdog_log(msg: str):
    ts = datetime.now(timezone.utc).strftime("%H:%M:%S")
    entry = f"[{ts}] {msg}"
    WATCHDOG_LOG.append(entry)
    if len(WATCHDOG_LOG) > 20:
        WATCHDOG_LOG.pop(0)
    print(f"[WATCHDOG] {msg}", flush=True)


def _watchdog_loop():
    """Self-healing watchdog — checks every 60s, auto-fixes anything broken."""
    time.sleep(10)
    _watchdog_log("Watchdog started — monitoring all services")
    hb_path = os.path.expanduser("~/.local/state/sf-poller-heartbeat.json")
    db_path = os.path.expanduser("~/.local/state/casenotify.db")
    cfg_path = CONFIG_PATH
    log_path = os.path.expanduser("~/Library/Logs/sf-case-poller.log")
    bin_dir = os.path.expanduser("~/.local/bin")

    while True:
        try:
            # ── 1. SF Poller process ──
            r = subprocess.run(["launchctl", "list"], capture_output=True, text=True, timeout=5)
            if POLLER_LABEL not in (r.stdout or ""):
                _watchdog_log("⚠ SF Poller not running — restarting...")
                plist = os.path.join(LAUNCH_DIR, f"{POLLER_LABEL}.plist")
                if os.path.exists(plist):
                    subprocess.run(["launchctl", "unload", plist], capture_output=True, timeout=5)
                    time.sleep(1)
                    subprocess.run(["launchctl", "load", plist], capture_output=True, timeout=5)
                    subprocess.run(["launchctl", "start", POLLER_LABEL], capture_output=True, timeout=5)
                    _watchdog_log("✓ SF Poller restarted")
                else:
                    # Plist missing — recreate it
                    _watchdog_log("⚠ Poller plist missing — recreating...")
                    python = subprocess.run(["which", "python3"], capture_output=True, text=True).stdout.strip()
                    ssh_sock = os.environ.get("SSH_AUTH_SOCK", "")
                    home_dir = os.path.expanduser("~")
                    plist_content = f'''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>{POLLER_LABEL}</string>
<key>ProgramArguments</key><array><string>{python}</string><string>{bin_dir}/sf-case-poller</string><string>poll</string></array>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>{home_dir}</string><key>SSH_AUTH_SOCK</key><string>{ssh_sock}</string></dict>
<key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>
<key>StandardOutPath</key><string>{log_path}</string>
<key>StandardErrorPath</key><string>{log_path}</string>
</dict></plist>'''
                    os.makedirs(LAUNCH_DIR, exist_ok=True)
                    with open(plist, "w") as f:
                        f.write(plist_content)
                    subprocess.run(["launchctl", "load", plist], capture_output=True, timeout=5)
                    subprocess.run(["launchctl", "start", POLLER_LABEL], capture_output=True, timeout=5)
                    _watchdog_log("✓ Poller plist recreated and started")

            # ── 2. Email is supportshell SMTP (no Mail.app required) ──

            # ── 3. SSH/GraphQL status (from heartbeat — no slow SSH call) ──
            try:
                with open(hb_path) as f:
                    hb = json.load(f)
                last = datetime.fromisoformat(hb["last_successful_poll"])
                age = (datetime.now(timezone.utc) - last.replace(tzinfo=timezone.utc)).total_seconds()
                ssh_ok = hb.get("status") == "OK" and age < 300 and hb.get("cases", 0) > 0
                SSH_STATUS["running"] = ssh_ok
                SSH_STATUS["last_check"] = time.time()
                if not ssh_ok:
                    st = hb.get("status") or "?"
                    _watchdog_log(f"⚠ GraphQL: heartbeat stale ({int(age)}s) or status={st}")
                    if st == "DISCOVERY_FAILED" or hb.get("cases", 0) == 0:
                        _watchdog_log(f"→ Heal: {HEAL_CMD}")
                        err = str(hb.get("error") or "")[:120]
                        if err:
                            _watchdog_log(f"→ Last error: {err}")
            except FileNotFoundError:
                pass
            except Exception as e:
                SSH_STATUS["running"] = False

            # ── 4. Local SMTP catcher (optional — real mail uses supportshell SMTP) ──
            if SMTP_ENABLED:
                try:
                    import smtplib
                    with smtplib.SMTP("127.0.0.1", 2525, timeout=3) as s:
                        s.noop()
                except Exception:
                    _watchdog_log("⚠ Local SMTP :2525 down (dashboard catcher only; supportshell mail OK)")

            # ── 5. Heartbeat freshness → force restart stale poller ──
            try:
                with open(hb_path) as f:
                    hb = json.load(f)
                last = datetime.fromisoformat(hb["last_successful_poll"])
                age = (datetime.now(timezone.utc) - last.replace(tzinfo=timezone.utc)).total_seconds()
                if age > 300:
                    _watchdog_log(f"⚠ Poller stale ({int(age)}s) — force restarting...")
                    subprocess.run(["launchctl", "stop", POLLER_LABEL], capture_output=True, timeout=5)
                    time.sleep(2)
                    subprocess.run(["launchctl", "start", POLLER_LABEL], capture_output=True, timeout=5)
                    _watchdog_log("✓ Poller force-restarted")
            except FileNotFoundError:
                pass
            except Exception:
                pass

            # ── 6. Config file missing → recreate with defaults ──
            if not os.path.exists(cfg_path):
                _watchdog_log("⚠ Config missing — recreating defaults...")
                user = os.environ.get("USER", "mzakria")
                cfg = {"notify_email": f"{user}@redhat.com", "supportshell_user": user}
                os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
                with open(cfg_path, "w") as f:
                    json.dump(cfg, f, indent=2)
                _watchdog_log("✓ Config recreated with defaults")

            # ── 7. DB file missing → next poller cycle will recreate, but trigger poll now ──
            if not os.path.exists(db_path):
                _watchdog_log("⚠ Database missing — triggering immediate poll...")
                subprocess.run(["launchctl", "stop", POLLER_LABEL], capture_output=True, timeout=5)
                time.sleep(1)
                subprocess.run(["launchctl", "start", POLLER_LABEL], capture_output=True, timeout=5)
                _watchdog_log("✓ Poller restarted to rebuild database")

            # ── 8. Log file too large (>50MB) → rotate ──
            try:
                if os.path.exists(log_path) and os.path.getsize(log_path) > 50_000_000:
                    _watchdog_log("⚠ Log file >50MB — rotating...")
                    rotated = log_path + ".old"
                    if os.path.exists(rotated):
                        os.remove(rotated)
                    os.rename(log_path, rotated)
                    _watchdog_log("✓ Log rotated (old → .old)")
            except Exception:
                pass

            # ── 9. Stuck notifications → process retry queue ──
            try:
                import sqlite3
                conn = sqlite3.connect(db_path, timeout=5)
                conn.row_factory = sqlite3.Row
                stuck = conn.execute(
                    "SELECT COUNT(*) as c FROM notifications WHERE status='RETRY' AND "
                    "created_at < datetime('now', '-30 minutes')"
                ).fetchone()["c"]
                if stuck > 0:
                    _watchdog_log(f"⚠ {stuck} stuck notifications — marking for retry...")
                    conn.execute(
                        "UPDATE notifications SET status='PENDING', retry_count=0 WHERE status='RETRY' AND "
                        "created_at < datetime('now', '-30 minutes')"
                    )
                    conn.commit()
                    _watchdog_log(f"✓ {stuck} notifications reset to PENDING")
                conn.close()
            except Exception:
                pass

            # ── 10. JSON state file missing → trigger poll ──
            json_state = os.path.expanduser("~/.local/state/sf-case-status.json")
            if not os.path.exists(json_state) and os.path.exists(db_path):
                _watchdog_log("⚠ Dashboard JSON missing — triggering poll...")
                subprocess.Popen(
                    [subprocess.run(["which", "python3"], capture_output=True, text=True).stdout.strip(),
                     os.path.join(bin_dir, "sf-case-poller"), "--once"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                _watchdog_log("✓ Background poll triggered")

        except Exception as e:
            _watchdog_log(f"✗ Watchdog error: {str(e)[:80]}")

        time.sleep(60)


