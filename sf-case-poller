    script_path = os.path.expanduser("~/.local/bin/sf-case-poller")

    subprocess.run(["launchctl", "stop", label], capture_output=True)
    subprocess.run(["launchctl", "unload", plist_path], capture_output=True)
    if os.path.exists(plist_path):
        os.remove(plist_path)
    print("Uninstalled. Config and DB preserved in ~/.local/state/")

def cmd_start():
    label = _get_label()
    subprocess.run(["launchctl", "start", label])
    print("Started")

def cmd_stop():
    label = _get_label()
    subprocess.run(["launchctl", "stop", label])
    print("Stopped")

def cmd_restart():
    label = _get_label()
    subprocess.run(["launchctl", "stop", label], capture_output=True)
    import time as _t; _t.sleep(2)
    subprocess.run(["launchctl", "start", label])
    print("Restarted")

def cmd_logs():
    os.execvp("tail", ["tail", "-f", os.path.expanduser("~/Library/Logs/sf-case-poller.log")])

def main() -> int:
    args = sys.argv[1:]
    cmd = args[0] if args else ""

    # Commands that don't need DB
    if cmd == "install":
        cmd_install()
        return 0
    if cmd == "uninstall":
        cmd_uninstall()
        return 0
    if cmd == "start":
        cmd_start()
        return 0
    if cmd == "stop":
        cmd_stop()
        return 0
    if cmd == "restart":
        cmd_restart()
        return 0
    if cmd == "logs":
        cmd_logs()
        return 0
    if cmd in ("dashboard", "web", "open"):
        print("Local web dashboard removed — use: sf-case-poller status | health | logs")
        return 0
    if cmd in ("help", "--help", "-h", ""):
        print("SF Case Notification Center")
        print("")
        print("Setup:")
        print("  sf-case-poller install     Install and start (one-time)")
        print("  sf-case-poller uninstall   Remove everything")
        print("")
        print("Control:")
        print("  sf-case-poller start       Start poller")
        print("  sf-case-poller stop        Stop poller")
        print("  sf-case-poller restart     Restart poller")
        print("")
        print("Monitor:")
        print("  sf-case-poller status      Check status")
        print("  sf-case-poller health      Health check")
        print("  sf-case-poller logs        View live logs")
        print("  sf-case-poller history     Notification history")
        print("  sf-case-poller test-email  Test email delivery")
        return 0

    conn = _init_db()

    if cmd == "--status" or cmd == "status":
        cmd_status(conn)
        return 0

    if cmd == "--health" or cmd == "health":
        cmd_health(conn)
        return 0

    if cmd == "--test-email" or cmd == "test-email":
        cmd_test_email()
        return 0

    if cmd == "--test" or cmd == "test":
        cmd_health(conn)
        print()
        cmd_test_email()
        return 0

    if cmd == "--history" or cmd == "history":
        cmd_history(conn)
        return 0

    if cmd == "--once" or cmd == "once":
        log_info("poll_started", mode="once", url=CASE_LIST_URL[:80])
        stats = poll_once(conn)
        print(f"Poll complete: cases={stats['cases']} events={stats['events']} notifs={stats['notifications']} status={stats['status']}")
        return 0

    if cmd != "poll":
        print(f"Unknown command: {cmd}")
        print("Run: sf-case-poller help")
        return 1

    # Default: continuous polling
    log_info("service_started", interval=INTERVAL, url=CASE_LIST_URL[:80], pid=os.getpid())

    def _handle_signal(sig, frame):
        log_info("service_stopped", signal=sig)
        sys.exit(0)
    signal.signal(signal.SIGTERM, _handle_signal)
    signal.signal(signal.SIGINT, _handle_signal)

    # Startup reconciliation — if we haven't run in >15 min, re-baseline
    try:
        with open(HEARTBEAT_PATH) as f:
            hb = json.load(f)
        last = datetime.fromisoformat(hb["last_successful_poll"])
        gap = (datetime.now(timezone.utc) - last.replace(tzinfo=timezone.utc)).total_seconds()
        if gap > 900:
            log_warn("startup_reconciliation", gap_seconds=int(gap))
            _db_set(conn, "initialized", "0")
    except Exception:
        pass

    POLL_INTERVAL = 60  # GraphQL poll every 1 minute (status + comments in one call)
    consecutive_failures = 0

    while True:
        try:
            stats = poll_once(conn)
            process_retry_queue(conn)

            if stats.get("status") == "OK":
                consecutive_failures = 0
            else:
                consecutive_failures += 1

            # Self-healing: if 3 consecutive failures, reset circuit breaker
            if consecutive_failures >= 3 and ssh_circuit.is_open:
                log_warn("self_heal_reset_circuit", failures=consecutive_failures)
                ssh_circuit.failures = 0
                ssh_circuit.opened_at = 0.0

            # Self-healing: if 5 consecutive failures, re-baseline on next success
            if consecutive_failures >= 5:
                log_warn("self_heal_rebaseline", failures=consecutive_failures,
                         action="will re-baseline on next successful poll")
                _db_set(conn, "initialized", "0")

        except Exception as exc:
            consecutive_failures += 1
            log_error("poll_error", error=str(exc)[:200], consecutive_failures=consecutive_failures)

        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        log_info("stopped", reason="keyboard_interrupt")
    except Exception as exc:
        log_error("fatal", error=str(exc)[:200])
        sys.exit(1)
