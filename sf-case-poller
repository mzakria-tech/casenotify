    except Exception:
        known_owner = ""
    try:
        with open(JSON_STATE_PATH) as f:
            st = json.load(f)
        cases = st.get("cases") if isinstance(st, dict) else st
        if isinstance(cases, dict):
            case_iter = list(cases.values())[:10]
        else:
            case_iter = list(cases or [])[:10]
        for c in case_iter:
            if not isinstance(c, dict):
                continue
            fields = c.get("fields") if isinstance(c.get("fields"), dict) else {}
            cn = str(
                c.get("CaseNumber") or c.get("number") or fields.get("CaseNumber") or ""
            ).strip()
            if cn:
                known_case_numbers.append(cn)
    except Exception:
        pass
    known_cases_json = json.dumps(known_case_numbers)

    script = f'''
import json, urllib.request, urllib.parse, os, urllib.error, re

SEED_OWNER = {json.dumps(known_owner)}
SEED_CASES = {known_cases_json}
SF_ID_RE = re.compile(r"^005[A-Za-z0-9]{{12,18}}$")

def get_token():
    gql_file = os.path.expanduser("~/.cache/hydra-mcp/tokens/redhat-sso-token.json")
    if not os.path.exists(gql_file):
        gql_file = "/home/remote/{SSH_USER}/.yank/oidc-tokens.json"
    with open(gql_file) as f:
        d = json.load(f)
    data = urllib.parse.urlencode({{
        "grant_type": "refresh_token",
        "refresh_token": d["refresh_token"],
        "client_id": "cee-supportshell-deviceauth"
    }}).encode()
    req = urllib.request.Request(
        "https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token", data)
    return json.loads(urllib.request.urlopen(req, timeout=10).read())["access_token"]

def gql_request(query, variables, token):
    body = json.dumps({{"query": query, "variables": variables}}).encode()
    req = urllib.request.Request("https://vpn.graphql.redhat.com", data=body)
    req.add_header("Authorization", "Bearer " + token)
    req.add_header("Content-Type", "application/json")
    req.add_header("Accept", "application/json")
    # Required by vpn.graphql.redhat.com — missing headers => HTTP 400 Bad Request
    req.add_header("apollographql-client-name", "redhat-hydra-mcp-server")
    req.add_header("apollographql-client-version", "0.1.0")
    try:
        resp = urllib.request.urlopen(req, timeout=30)
        data = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:500]
        raise RuntimeError("HTTP %s: %s" % (e.code, detail))
    errs = data.get("errors") or []
    if errs and not (data.get("data") or {{}}):
        raise RuntimeError("GraphQL: %s" % (errs[0].get("message") or errs[0])[:300])
    return data

def _valid_oid(oid):
    return bool(oid and SF_ID_RE.match(oid.strip()))

def resolve_owner_id(token):
    owner_id_file = os.path.expanduser("~/.cache/hydra-mcp/sf-owner-id.txt")
    candidates = []

    # 1) GraphQL currentUser — works cold-start, no Case_Owner_Alias__c
    try:
        r = gql_request("query {{ redhat_support_uiapi {{ currentUser {{ Id }} }} }}", {{}}, token)
        oid = ((r.get("data") or {{}}).get("redhat_support_uiapi") or {{}}).get("currentUser") or {{}}
        oid = (oid.get("Id") or "").strip()
        if _valid_oid(oid):
            candidates.append(oid)
    except Exception:
        pass

    for src in (SEED_OWNER,):
        if _valid_oid(src):
            candidates.append(src.strip())
    if os.path.exists(owner_id_file):
        try:
            cached = open(owner_id_file).read().strip()
            if _valid_oid(cached):
                candidates.append(cached)
        except Exception:
            pass

    # 2) Fallback: OwnerId from a known case number
    case_numbers = list(SEED_CASES or [])
    mcp_ctx = os.path.expanduser("~/.yank/mcp-context.json")
    if os.path.exists(mcp_ctx):
        try:
            ctx = json.load(open(mcp_ctx))
            cur = str(ctx.get("current_case") or "").strip()
            if cur:
                case_numbers.insert(0, cur)
            for rc in (ctx.get("recent_cases") or []):
                cn = str(rc.get("case_number") or "").strip()
                if cn:
                    case_numbers.append(cn)
        except Exception:
            pass

    if not candidates:
        seen = set()
        for cn in case_numbers:
            if not cn or cn in seen:
                continue
            seen.add(cn)
            q = """query {{
  redhat_support_uiapi {{
    query {{
      RedHatSupportCase(where: {{ CaseNumber__c: {{ eq: "%s" }} }}, first: 1) {{
        edges {{ node {{ OwnerId {{ value }} CaseNumber__c {{ value }} }} }}
      }}
    }}
  }}
}}""" % cn
            try:
                r = gql_request(q, {{}}, token)
                edges = (r.get("data", {{}}).get("redhat_support_uiapi", {{}})
                         .get("query", {{}}).get("RedHatSupportCase", {{}}).get("edges", []))
                if edges:
                    oid = ((edges[0].get("node", {{}}).get("OwnerId", {{}}) or {{}}).get("value") or "").strip()
                    if _valid_oid(oid):
                        candidates.append(oid)
                        break
            except Exception:
                continue

    owner_id = candidates[0] if candidates else ""
    if owner_id:
        try:
            os.makedirs(os.path.dirname(owner_id_file), exist_ok=True)
            with open(owner_id_file, "w") as f:
                f.write(owner_id)
        except Exception:
            pass
    return owner_id

