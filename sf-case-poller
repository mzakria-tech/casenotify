def cmd_health(conn: sqlite3.Connection):
    """Run health checks."""
    checks = []

    # GraphQL API (via SSH)
    # Checked below with SSH/GraphQL

    # Supportshell SMTP (corp relay)
    if SSH_USER and not ssh_circuit.is_open:
        try:
            probe = _ssh_python(
                'import smtplib; s=smtplib.SMTP("smtp.corp.redhat.com",25,timeout=10); s.noop(); s.quit(); print("OK")',
                timeout=20,
            )
            checks.append(("Supportshell SMTP", "PASS" if "OK" in (probe or "") else "FAIL"))
        except Exception:
            checks.append(("Supportshell SMTP", "FAIL"))
    else:
        checks.append(("Supportshell SMTP", "SKIP (no SSH)"))

    # SSH + GraphQL
    if ssh_circuit.is_open:
        checks.append(("SSH/GraphQL", "FAIL (circuit open)"))
    elif SSH_USER:
        try:
            r = subprocess.run(
                ["ssh", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes",
                 f"{SSH_USER}@{SUPPORTSHELL_HOST}", "echo ok"],
                capture_output=True, text=True, timeout=15,
            )
            checks.append(("SSH/GraphQL", "PASS" if r.returncode == 0 else "FAIL"))
        except Exception:
            checks.append(("SSH/GraphQL", "FAIL"))
    else:
        checks.append(("SSH/GraphQL", "SKIP (no user)"))

    # SQLite
    try:
        conn.execute("SELECT 1").fetchone()
        checks.append(("SQLite DB", "PASS"))
    except Exception:
        checks.append(("SQLite DB", "FAIL"))

    # Heartbeat freshness
    try:
        with open(HEARTBEAT_PATH) as f:
            hb = json.load(f)
        last = datetime.fromisoformat(hb["last_successful_poll"])
        age = (datetime.now(timezone.utc) - last.replace(tzinfo=timezone.utc)).total_seconds()
        checks.append(("Heartbeat", f"PASS ({int(age)}s ago)" if age < 600 else f"WARN ({int(age)}s stale)"))
    except Exception:
        checks.append(("Heartbeat", "FAIL (no data)"))

    # Data source
    checks.append(("Data Source", "PASS (GraphQL API)"))

    print("═══ Health Check ═══")
    all_pass = True
    for name, result in checks:
        symbol = "✓" if result.startswith("PASS") else ("⚠" if result.startswith("WARN") or result.startswith("SKIP") else "✗")
        print(f"  {symbol} {name:<20} {result}")
        if result.startswith("FAIL"):
            all_pass = False
    print(f"\n  Overall: {'HEALTHY' if all_pass else 'DEGRADED'}")


